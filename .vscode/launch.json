{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Flask app",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\app.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "5000"
            ],
            "env": {
                "PYTHONIOENCODING": "utf-8"
            },
            "jinja": true
        }
    ]
}